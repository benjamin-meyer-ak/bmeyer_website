# Check what's actually installed and working
library(blogdown)
cat("blogdown version:", as.character(packageVersion("blogdown")), "\n")
cat("Hugo version (blogdown says):\n")
hugo_version()
# Check R environment - is blogdown installed? What else is available?
installed_pkgs <- rownames(installed.packages())
cat("blogdown installed:", "blogdown" %in% installed_pkgs, "\n")
cat("rmarkdown installed:", "rmarkdown" %in% installed_pkgs, "\n")
cat("knitr installed:", "knitr" %in% installed_pkgs, "\n")
# Check if Hugo is available via blogdown's path
hugo_dirs <- c(
file.path(Sys.getenv("APPDATA"), "Hugo"),
file.path(Sys.getenv("LOCALAPPDATA"), "Hugo"),
"~/AppData/Roaming/Hugo"
)
for (d in hugo_dirs) {
if (dir.exists(d)) cat("Hugo dir found:", d, "\n")
}
install.packages("blogdown")
blogdown:::serve_site()
blogdown:::serve_site()
blogdown:::serve_site()
# Check if blogdown is installed and Hugo is findable
cat("blogdown installed:", requireNamespace("blogdown", quietly = TRUE), "\n")
cat("Hugo version:\n")
try(blogdown::hugo_version())
blogdown::serve_site(port = 4322)
options(blogdown.server.timeout = 120)
blogdown::serve_site()
writeLines(c(
"# REMEMBER to restart R after you modify and save this file!",
"",
"# First, execute the global .Rprofile if it exists. You may configure blogdown",
"# options there, too, so they apply to any blogdown projects. Feel free to",
"# ignore this part if it sounds too complicated to you.",
'if (file.exists("~/.Rprofile")) {',
'  base::sys.source("~/.Rprofile", envir = environment())',
"}",
"",
"# Now set options to customize the behavior of blogdown for this project. Below",
"# are a few sample options; for more options, see",
"# https://bookdown.org/yihui/blogdown/global-options.html",
"options(",
"  # to automatically serve the site on RStudio startup, set this option to TRUE",
"  blogdown.serve_site.startup = FALSE,",
"  # to disable knitting Rmd files on save, set this option to FALSE",
"  blogdown.knit.on_save = TRUE,",
"  # build .Rmd to .html (via Pandoc); to build to Markdown, set this option to 'markdown'",
"  blogdown.method = 'html',",
"  # Hugo module verification takes >30s on startup; 120s prevents timeout",
"  blogdown.server.timeout = 120",
")",
"",
"# fix Hugo version",
"options(blogdown.hugo.version = '0.107.0')"
), ".Rprofile")
cat("Done\n")
library(yaml)
fm <- function(f) { x <- readLines(f, warn = FALSE); i <- which(x == "---"); yaml.load(paste(x[(i[1]+1):(i[2]-1)], collapse = "\n")) }
pubs <- list.files("content/publications", "index.md", recursive = TRUE, full.names = TRUE)
do.call(rbind, lapply(pubs, \(f) { y <- fm(f); data.frame(dir = basename(dirname(f)), date = substr(y$date %||% "", 1, 10), title = y$title, authors = paste(unlist(y$authors), collapse = "; "), pub = y$publication %||% "", doi = y$doi %||% "", pdf = file.exists(file.path(dirname(f), paste0(basename(dirname(f)), ".pdf")))) }))
ev <- list.files("content/event", "index", recursive = TRUE, full.names = TRUE)
ev
library(yaml)
fm <- function(f) { x <- readLines(f, warn = FALSE); i <- which(x == "---"); list(y = yaml.load(paste(x[(i[1]+1):(i[2]-1)], collapse = "\n")), body = x[-(1:i[2])]) }
q <- function(x) paste0('"', gsub('"', '\\\\"', x), '"')
types <- c("2" = "Journal article", "4" = "Report", "7" = "Thesis")
dirs <- list.dirs("content/publications", recursive = FALSE)
info <- NULL
for (d in dirs) {
id <- basename(d); p <- fm(file.path(d, "index.md"))$y
out <- file.path("publications", id); dir.create(out, recursive = TRUE, showWarnings = FALSE)
feat <- list.files(d, "^featured\\.", full.names = TRUE)
pdf <- list.files(d, "\\.pdf$", full.names = TRUE)
file.copy(c(feat, pdf), out, overwrite = TRUE)
au <- unlist(p$authors); au[au == "admin"] <- "Benjamin Meyer"
au <- sub(", et al\\.$", " et al.", au)
abs_ok <- !is.null(p$abstract) && !grepl("Lorem ipsum", p$abstract)
links <- c(
if (length(pdf)) sprintf("- [Local PDF](%s)", basename(pdf)),
if (nzchar(p$url_pdf %||% "")) sprintf("- [Publisher / external PDF](%s)", p$url_pdf),
if (nzchar(p$url_project %||% "")) sprintf("- [Project page](%s)", p$url_project),
if (nzchar(p$url_slides %||% "")) sprintf("- [Slides](%s)", p$url_slides),
if (nzchar(p$url_video %||% "")) sprintf("- [Video](%s)", p$url_video))
# Gouin record carried a DOI duplicated from another paper
doi <- if (id == "gouin_2010_pah") "" else p$doi %||% ""
fmtr <- c("---", paste0("title: ", q(p$title)),
paste0("author: ", q(paste(au, collapse = ", "))),
paste0("date: ", substr(p$date, 1, 10)),
if (nzchar(p$summary %||% "")) paste0("description: ", q(p$summary)),
paste0("categories: [", types[[as.character(p$publication_types[[1]])]], "]"),
if (length(feat)) paste0("image: ", basename(feat[1])),
if (nzchar(doi)) paste0("doi: ", q(doi)),
if (length(p$author_notes) && !is.null(p$author_notes[[1]])) paste0("note: ", q(p$author_notes[[1]])),
"---", "")
body <- c(if (nzchar(doi)) sprintf("DOI: [%s](https://doi.org/%s)", doi, doi), if (length(p$author_notes) && !is.null(p$author_notes[[1]])) paste0("*", p$author_notes[[1]], "*"), "",
if (abs_ok) c("## Abstract", "", p$abstract, ""), "## Links", "", links)
writeLines(c(fmtr, body), file.path(out, "index.qmd"))
info <- rbind(info, data.frame(id, pdfs = length(pdf), feat = length(feat), abs_ok, doi_blank = !nzchar(doi)))
}
info
system("du -sh publications")
id <- rstudioapi::terminalExecute("quarto preview --port 4848")
Sys.sleep(15)
rstudioapi::terminalBuffer(id) |> tail(10)
