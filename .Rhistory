# Check what's actually installed and working
library(blogdown)
cat("blogdown version:", as.character(packageVersion("blogdown")), "\n")
cat("Hugo version (blogdown says):\n")
hugo_version()
# Check R environment - is blogdown installed? What else is available?
installed_pkgs <- rownames(installed.packages())
cat("blogdown installed:", "blogdown" %in% installed_pkgs, "\n")
cat("rmarkdown installed:", "rmarkdown" %in% installed_pkgs, "\n")
cat("knitr installed:", "knitr" %in% installed_pkgs, "\n")
# Check if Hugo is available via blogdown's path
hugo_dirs <- c(
file.path(Sys.getenv("APPDATA"), "Hugo"),
file.path(Sys.getenv("LOCALAPPDATA"), "Hugo"),
"~/AppData/Roaming/Hugo"
)
for (d in hugo_dirs) {
if (dir.exists(d)) cat("Hugo dir found:", d, "\n")
}
install.packages("blogdown")
blogdown:::serve_site()
blogdown:::serve_site()
blogdown:::serve_site()
# Check if blogdown is installed and Hugo is findable
cat("blogdown installed:", requireNamespace("blogdown", quietly = TRUE), "\n")
cat("Hugo version:\n")
try(blogdown::hugo_version())
blogdown::serve_site(port = 4322)
options(blogdown.server.timeout = 120)
blogdown::serve_site()
writeLines(c(
"# REMEMBER to restart R after you modify and save this file!",
"",
"# First, execute the global .Rprofile if it exists. You may configure blogdown",
"# options there, too, so they apply to any blogdown projects. Feel free to",
"# ignore this part if it sounds too complicated to you.",
'if (file.exists("~/.Rprofile")) {',
'  base::sys.source("~/.Rprofile", envir = environment())',
"}",
"",
"# Now set options to customize the behavior of blogdown for this project. Below",
"# are a few sample options; for more options, see",
"# https://bookdown.org/yihui/blogdown/global-options.html",
"options(",
"  # to automatically serve the site on RStudio startup, set this option to TRUE",
"  blogdown.serve_site.startup = FALSE,",
"  # to disable knitting Rmd files on save, set this option to FALSE",
"  blogdown.knit.on_save = TRUE,",
"  # build .Rmd to .html (via Pandoc); to build to Markdown, set this option to 'markdown'",
"  blogdown.method = 'html',",
"  # Hugo module verification takes >30s on startup; 120s prevents timeout",
"  blogdown.server.timeout = 120",
")",
"",
"# fix Hugo version",
"options(blogdown.hugo.version = '0.107.0')"
), ".Rprofile")
cat("Done\n")
